# QA Brain -- hosted mode environment.
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
#
# `.env` is gitignored (the repository .gitignore keeps only `deploy/.env.example`) and CI
# asserts it with `git check-ignore .env`. NOTHING IN THIS FILE IS A REAL SECRET, and nothing
# in the copy you make should be either where a Compose secret can carry it instead: file
# secrets are mounted read-only under /run/secrets and never enter a process environment,
# where `docker inspect`, a crash dump or a child process would find them
# (docs/deployment.md section 6, docs/security-threat-model.md T6).
#
# Values here do two jobs. Compose interpolates them into docker-compose*.yml, and the
# gateway expands the same `${VAR}` / `${VAR:-default}` syntax inside deploy/qa-brain.yaml.
# Every value the gateway expands is registered with the redactor, so an expanded literal can
# never appear in a log line or an action_log row.
#
# M0 STATUS: hosted mode is not wired to code until milestone M5 (Feb 2027). The variables
# below are the contract those milestones implement.

# =======================================================================================
# Images and version
# =======================================================================================

# Gateway image and tag. `docker.yml` publishes both on a `v*` tag.
QA_BRAIN_IMAGE=ghcr.io/chinmaydhokey/qa-brain
QA_BRAIN_VERSION=0.1.0
# Optional digest pin, appended to the tag: `@sha256:...`. The prod overlay leaves the tag
# in place so `docker images` stays readable, and the digest is what actually gets pulled.
# Take it from the docker.yml job summary and verify it with cosign before deploying.
QA_BRAIN_IMAGE_DIGEST=

# Browser sidecar. The tag IS the Playwright version, and it must equal the `playwright`
# npm pin in packages/adapter-playwright (1.62.1) -- one browser revision everywhere.
QA_BRAIN_BROWSER_IMAGE=ghcr.io/chinmaydhokey/qa-brain-browser
QA_BRAIN_BROWSER_VERSION=1.62.1
QA_BRAIN_BROWSER_IMAGE_DIGEST=

# Egress proxy, built from docker/egress/Dockerfile (no upstream image exists).
QA_BRAIN_EGRESS_IMAGE=qa-brain-egress
QA_BRAIN_EGRESS_VERSION=v0.0.4

# =======================================================================================
# Public identity
# =======================================================================================

# Hostname Caddy serves and requests a certificate for. Must resolve to this VM's public IP
# before the first `up`, or ACME fails.
QA_BRAIN_PUBLIC_HOST=qa.example.com

# Full origin. Feeds http.allowedHosts / http.allowedOrigins in deploy/qa-brain.yaml -- the
# gateway answers 403 to any other Host or Origin, which is what makes DNS rebinding and
# hostile cross-origin browser requests fail (threat model T8).
QA_BRAIN_PUBLIC_URL=https://qa.example.com

# Address Let's Encrypt uses for expiry notices.
CADDY_ACME_EMAIL=ops@example.com

# =======================================================================================
# Gateway behaviour  (see packages/core/src/config-schema.ts for the authoritative schema)
# =======================================================================================

# trace | debug | info | warn | error | silent
QA_BRAIN_LOG_LEVEL=info

# What action_log keeps for tool arguments: shape (keys + types), redacted (values after
# redaction) or none. `shape` is the hosted default; args_hash is stored regardless, so step
# caching works without ever persisting a value.
QA_BRAIN_LOG_ARGS_MODE=shape

# Per-call timeout for proxied tool calls, ms. Must stay <= the sidecar's
# PLAYWRIGHT_MCP_PING_TIMEOUT_MS (60000) or a long call dies as "Session not found".
QA_BRAIN_CALL_TIMEOUT_MS=60000

# Hard cap on serialized text returned to the LLM (~20k tokens, under Claude Code's 25k MCP
# result ceiling). Over-cap results are truncated with a `[truncated N chars]` marker.
QA_BRAIN_MAX_RESULT_CHARS=80000

# ttlMs advertised on tools/list (2026-07-28 CacheableResult).
QA_BRAIN_TOOLS_LIST_TTL_MS=300000

# List the not-yet-implemented qa_* stub tools in tools/list. Keep false in production:
# a listed tool that answers "not implemented" costs tokens and confuses the model.
QA_BRAIN_EXPOSE_STUBS=false

# Streamable HTTP URL of the browser sidecar on the internal `browsers` network.
QA_BRAIN_PLAYWRIGHT_URL=http://playwright-mcp:8931/mcp

# ---------------------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. The single static bearer token accepted by
# `qa-brain serve --transport http` (threat model T7). Hosted mode does NOT use it: API keys
# are `qab_<keyid>_<secret>`, minted by `qa-brain apikey create`, printed once and stored as
# argon2id hashes in the api_key table (M5, ADR-0012). `qa-brain doctor` warns when this is
# set while http.host is not a loopback address.
# ---------------------------------------------------------------------------------------
QA_BRAIN_TOKEN=

# =======================================================================================
# Postgres  (store + pg-boss queue -- one database, no Redis, ADR-0007)
# =======================================================================================

POSTGRES_USER=qa_brain
POSTGRES_DB=qa_brain
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100

# NOTE: no POSTGRES_PASSWORD here on purpose. The password lives in the Compose secret
# `pg_password`; postgres reads it via POSTGRES_PASSWORD_FILE and the app services will read
# it via QA_BRAIN_DATABASE_PASSWORD_FILE (=/run/secrets/pg_password).
#   openssl rand -base64 32 | tr -d '\n' > secrets/pg_password && chmod 600 secrets/pg_password

# Connection string WITHOUT credentials, expanded into store.url in deploy/qa-brain.yaml.
QA_BRAIN_DATABASE_URL=postgres://qa_brain@postgres:5432/qa_brain

# Where the Compose secret files live. Point this outside the working tree on a real VM
# (e.g. /etc/qa-brain/secrets, dir 0700, files 0600): `deploy/secrets/` is not covered by
# the repository .gitignore today.
QA_BRAIN_SECRETS_DIR=./secrets

# =======================================================================================
# Object storage  (SeaweedFS, S3-compatible -- ADR-0008. MinIO CE is no longer published.)
# =======================================================================================

QA_BRAIN_S3_ENDPOINT=http://seaweedfs:8333
QA_BRAIN_S3_BUCKET=qa-brain-artifacts
QA_BRAIN_S3_REGION=us-east-1
# Key prefix inside the bucket. Empty means the bucket root.
QA_BRAIN_S3_PREFIX=
# Profile name inside the `s3_credentials` INI file that the AWS SDK reads via
# AWS_SHARED_CREDENTIALS_FILE=/run/secrets/s3_credentials. Access keys are NOT env vars.
QA_BRAIN_S3_PROFILE=qa-brain
# forcePathStyle is hard-coded true in deploy/qa-brain.yaml: SeaweedFS does not do
# virtual-host-style bucket addressing.

# The bucket is private with no listing; tools return artefact ids and `ArtifactStore.url()`
# mints a 15-minute presigned GET after an ownership check (threat model T11). A 30-day
# lifecycle rule created by `qa-brain db migrate` bounds retention.

# =======================================================================================
# Observability  (docs/observability.md section 8)
# =======================================================================================

# none | otlp. `none` installs a no-op facade -- the correlation substrate (traceparent
# passthrough, action_log.traceparent, trace_id on log lines) works either way.
QA_BRAIN_OTEL_EXPORTER=otlp

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# gRPC is not bundled; the SDK exports OTLP over HTTP to keep the dependency set small.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=hosted
# parentbased_always_on | parentbased_traceidratio (ratio via OTEL_TRACES_SAMPLER_ARG)
OTEL_TRACES_SAMPLER=parentbased_always_on

# Where the collector forwards traces. dev overlay sets jaeger:4317, prod sets tempo:4317.
QA_BRAIN_OTEL_TRACES_ENDPOINT=jaeger:4317
# memory_limiter budget for the collector, MiB. Keep it under the container mem_limit.
QA_BRAIN_OTEL_MEMORY_LIMIT_MIB=384

# Unset (empty) by default. `1` makes the gateway attach REDACTED
# gen_ai.tool.call.arguments to spans. The collector deletes that attribute again unless the
# `attributes/gen-ai-redact` processor is removed from its traces pipeline, so turning this
# on takes two deliberate changes, not one. Never carries raw arguments in either case.
QA_BRAIN_TRACE_ARGS=

# =======================================================================================
# LLM runner  (M1 skeleton, hosted worker from M5)
# =======================================================================================

# anthropic | openai-compatible (the latter covers OpenAI and a local Ollama endpoint,
# which is the answer for teams that need stricter retention than a hosted provider offers)
QA_BRAIN_LLM_PROVIDER=anthropic
QA_BRAIN_LLM_MODEL=claude-opus-5

# Leave EMPTY here. Put the real key in the environment of the deploying shell or, better,
# in a file secret once the runner reads one. It is matched by the `sk-` redaction pattern
# if it ever reaches a tool argument, but the goal is that it never gets that far.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hard stop per run, computed from gen_ai.usage.* and the driver's price table (threat
# model T14).
QA_BRAIN_LLM_BUDGET_USD_PER_RUN=2.00

# =======================================================================================
# GitHub integration  (M4)
# =======================================================================================

# A GitHub App installed per repository with contents:read, pull_requests:write,
# checks:write, issues:write -- never a personal access token, never a broader scope.
GITHUB_APP_ID=
# Path INSIDE the container. The key is a Compose secret so it cannot reach a child
# process's environment (threat model section 9).
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_key

# =======================================================================================
# Container hardening knobs
# =======================================================================================

# Path to the seccomp profile for the browser sidecar, relative to the Compose project
# directory (always `deploy/`, even when invoked as `-f deploy/docker-compose.yml`).
QA_BRAIN_SECCOMP_PROFILE=../docker/seccomp_profile.json
