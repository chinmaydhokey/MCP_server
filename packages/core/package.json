{
  "name": "@qa-brain/core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared contracts for QA Brain: config schema, interfaces, tool-name rules, redaction, handles",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
