{
  "name": "@qa-brain/adapter-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Upstream adapter for Playwright MCP: tool table, CLI resolution, flag validation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node22",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=22.12" },
  "dependencies": { "@qa-brain/core": "workspace:*", "playwright": "1.62.1" },
  "devDependencies": {}
}
