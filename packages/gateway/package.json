{
  "name": "@qa-brain/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "QA Brain gateway runtime: MCP server + upstream MCP clients, registry, router, action log, transports",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean --target node22",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@qa-brain/core": "workspace:*",
    "@qa-brain/store": "workspace:*",
    "@qa-brain/adapter-playwright": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "hono": "4.11.4",
    "zod": "4.4.3",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {}
}
