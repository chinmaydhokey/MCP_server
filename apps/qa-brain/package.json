{
  "name": "qa-brain",
  "version": "0.1.0",
  "description": "QA Brain CLI \u00e2\u20ac\u201d serve the MCP gateway (stdio/http), run diagnostics, list tools",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "qa-brain": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@qa-brain/core": "workspace:*",
    "@qa-brain/gateway": "workspace:*",
    "@qa-brain/adapter-playwright": "workspace:*",
    "@qa-brain/store": "workspace:*",
    "commander": "15.0.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@libsql/client": "0.17.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
