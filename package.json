{
  "name": "qa-brain-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "QA Brain \u00e2\u20ac\u201d an MCP gateway that turns LLM agents into persistent, self-healing, change-aware testers for web and mobile apps",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chinmaydhokey/MCP_server.git"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "biome ci .",
    "lint:fix": "biome check --write .",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "smoke": "vitest run --project e2e",
    "doctor": "node apps/qa-brain/dist/cli.js doctor",
    "changeset": "changeset",
    "clean": "pnpm -r exec rm -rf dist .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "3.0.1",
    "@types/node": "22.20.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
